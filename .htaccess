# Tektron — configuração de performance para hospedagem Apache (Hostnet).
# Sem efeito no GitHub Pages (ambiente de teste atual), que ignora .htaccess.

# --------------------------------------------------------------------------
# Página de erro 404
# --------------------------------------------------------------------------
# Caminho absoluto assume o site na raiz do domínio (tektron.ind.br/404.html).
# Se a Hostnet servir de dentro de uma subpasta, ajustar este caminho junto.
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# Redirects 301 — URLs antigas com tráfego indexado no Search Console
# (site antigo, conferido em 2026-08-13). Só as 9 URLs com clique/impressão
# real; o restante do site antigo (outros modelos, PDFs) tem volume
# baixo/zero e fica para revisão posterior, sem bloquear a virada.
# --------------------------------------------------------------------------
Redirect 301 /downloads.html https://www.tektron.ind.br/suporte/
Redirect 301 /quem-somos.html https://www.tektron.ind.br/institucional/
Redirect 301 /faq.html https://www.tektron.ind.br/suporte/#faq
Redirect 301 /contato.html https://www.tektron.ind.br/contato/
Redirect 301 /modelo2_teto.html https://www.tektron.ind.br/aplicacoes/teto-sobrepor.html
Redirect 301 /modelo6_ultrassom.html https://www.tektron.ind.br/aplicacoes/teto-sobrepor.html#situacao-ultrassonico
Redirect 301 /modelo7_fotocelula.html https://www.tektron.ind.br/produto/rele-fotoeletrico.html
Redirect 301 /modelo8_automacao.html https://www.tektron.ind.br/aplicacoes/minuterias.html
Redirect 301 /modelo9_compacta.html https://www.tektron.ind.br/aplicacoes/teto-sobrepor.html

# --------------------------------------------------------------------------
# Redirects 301 — PDFs antigos de ficha técnica ainda rastreados pelo
# Google (Search Console, conferido em 2026-08-15). Código de modelo bate
# direto com a ficha técnica atual, exceto MU450 → MU-500 (modelo
# descontinuado, mapeamento oficial na aba "Descontinuados" da planilha de
# especificações).
# --------------------------------------------------------------------------
Redirect 301 /files/pdf/TC5.pdf https://www.tektron.ind.br/assets/downloads/ficha-tecnica-tc-5.pdf
Redirect 301 /files/pdf/MICROONDAS.pdf https://www.tektron.ind.br/assets/downloads/ficha-tecnica-tkr.pdf
Redirect 301 /files/pdf/ME70.pdf https://www.tektron.ind.br/assets/downloads/ficha-tecnica-me-70.pdf
Redirect 301 /files/pdf/MI700.pdf https://www.tektron.ind.br/assets/downloads/ficha-tecnica-mi-700.pdf
Redirect 301 /files/pdf/BS70.pdf https://www.tektron.ind.br/assets/downloads/ficha-tecnica-bs-70.pdf
Redirect 301 /files/pdf/FC10.pdf https://www.tektron.ind.br/assets/downloads/ficha-tecnica-fc-10.pdf
Redirect 301 /files/pdf/FC15T.pdf https://www.tektron.ind.br/assets/downloads/ficha-tecnica-fc-15.pdf
Redirect 301 /files/pdf/MU450.pdf https://www.tektron.ind.br/assets/downloads/ficha-tecnica-mu-500.pdf

# --------------------------------------------------------------------------
# Compressão (gzip / brotli)
# --------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
    application/javascript application/json application/xml application/rss+xml \
    image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml application/rss+xml \
    image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# Cache de longo prazo — estáticos versionados (CSS/JS por ?v=, fontes e
# imagens por nome de arquivo estável). HTML fica com cache curto porque o
# conteúdo muda sem mudar de nome/versão.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html "access plus 1 hour"

  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|svg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
